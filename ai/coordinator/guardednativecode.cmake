set(guarded_code_code "#pragma once\nconstexpr std::array CODE_ASSETS{\n")
foreach(guarded_code_entry IN LISTS guarded_code_declarations)
    string(REPLACE "|" ";" guarded_code_fields "${guarded_code_entry}")
    list(GET guarded_code_fields 0 guarded_code_kind)
    list(GET guarded_code_fields 1 guarded_code_path)
    list(GET guarded_code_fields 2 guarded_code_global)
    list(GET guarded_code_fields 3 guarded_code_hash)
    list(GET guarded_code_fields 4 guarded_code_bytes)
    list(GET guarded_code_fields 5 guarded_code_parent)
    set(guarded_code_file "${CMAKE_CURRENT_SOURCE_DIR}/${guarded_code_path}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${guarded_code_file}")
    file(SIZE "${guarded_code_file}" guarded_code_size)
    set(guarded_code_literal "")
    set(guarded_code_available_bytes 0)
    if(guarded_code_size EQUAL guarded_code_bytes)
        file(SHA256 "${guarded_code_file}" guarded_code_actual_hash)
        string(TOUPPER "${guarded_code_actual_hash}" guarded_code_actual_hash)
        if(guarded_code_actual_hash STREQUAL guarded_code_hash)
            file(READ "${guarded_code_file}" guarded_code_hex HEX)
            string(REGEX REPLACE "(..)" "\\\\x\\1" guarded_code_literal "${guarded_code_hex}")
            set(guarded_code_available_bytes "${guarded_code_bytes}")
        endif()
    endif()
    if(guarded_code_available_bytes EQUAL 0)
        message(STATUS "Guarded native declaration unavailable: ${guarded_code_path}")
    endif()
    get_filename_component(guarded_code_name "${guarded_code_path}" NAME)
    string(APPEND guarded_code_code
        "CodeAsset{GuardedNativeCodeKind::${guarded_code_kind}, GuardedNativeCodeKind::${guarded_code_parent}, \"qrc:/guarded-stock-code/${guarded_code_name}\", \"${guarded_code_global}\", \"${guarded_code_hash}\", std::string_view{\"${guarded_code_literal}\", ${guarded_code_available_bytes}}},\n"
    )
endforeach()
string(APPEND guarded_code_code "};\n")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/guardednativeassets.h"
    CONTENT "${guarded_code_code}" @ONLY)
